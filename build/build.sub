# build.sub
# For building an Apptainer container

universe = vanilla
log = build.log

executable = /usr/bin/hostname

transfer_input_files = data/BadgerRLSystem.tar.gz,data/simrobot.def
transfer_output_files = simrobot.sif
transfer_output_remaps = "simrobot.sif = containers/simrobot.sif"
requirements = (HasCHTCStaging == true)

+IsBuildJob = true
request_cpus = 8
request_memory = 32GB
request_disk = 100GB

queue